<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A runner that regenerates and updates Soenneker.Bandwidth.OpenApiClient.</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Bandwidth.Runners.OpenApiClient</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="11.0.1451" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Soenneker.Kiota.Util" Version="11.0.175" />
        <PackageReference Include="Soenneker.Managers.Runners" Version="11.0.2670" />
        <PackageReference Include="Soenneker.OpenApi.Fixer" Version="11.0.412" />
        <PackageReference Include="Soenneker.OpenApi.Merger" Version="11.0.243" />
        <PackageReference Include="Soenneker.Playwright.Installation" Version="4.0.249" />
        <PackageReference Include="Soenneker.Playwrights.Extensions.Stealth" Version="11.0.191" />
        <PackageReference Include="Soenneker.Utils.File.Download" Version="11.0.1834" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Enums.DeployEnvironment" Version="11.0.262" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Extensions.ValueTask" Version="4.0.133" />
    </ItemGroup>
</Project>
